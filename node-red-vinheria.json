    {
        "id": "f656bee7633a033d",
        "type": "function",
        "z": "1c81e0c820e469f5",
        "name": "Processa Payload",
        "func": "let msgPayload = msg.payload;\nlet partes = msgPayload.split('|');\n\nlet dados = {};\nfor (let i = 0; i < partes.length; i += 2) {\n    let chave = partes[i];\n    let valor = partes[i+1];\n    if (chave === 'T') dados.temperatura = parseFloat(valor);\n    if (chave === 'H') dados.umidade = parseFloat(valor);\n    if (chave === 'L') dados.luminosidade = parseInt(valor);\n    if (chave === 'TS') dados.timestamp = valor;\n}\n\nreturn [\n    { payload: dados.temperatura, topic: \"Temperatura (°C)\" },\n    { payload: dados.umidade, topic: \"Umidade (%)\" },\n    { payload: dados.luminosidade, topic: \"Luminosidade (LDR)\" }\n];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
